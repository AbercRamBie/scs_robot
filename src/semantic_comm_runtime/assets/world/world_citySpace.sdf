<?xml version="1.0"?>
<sdf version="1.8">
  <!--
    Lightweight city world adapted from the primitive layout of the Gazebo
    Fuel `calibur/town_simple` world. Everything is defined inline so the
    simulation works offline and does not add mesh/model dependencies.
  -->
  <world name="city_space">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <!-- Ground and two crossing asphalt roads. -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>48 48 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>48 48 0.1</size></box></geometry>
          <material>
            <ambient>0.30 0.48 0.25 1</ambient>
            <diffuse>0.30 0.48 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_west_road">
      <static>true</static>
      <pose>0 0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>44 8 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>44 8 0.08</size></box></geometry>
          <material><diffuse>0.12 0.13 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_south_road">
      <static>true</static>
      <pose>0 0 0.065 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 44 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 44 0.08</size></box></geometry>
          <material><diffuse>0.12 0.13 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dashed centre markings are visual only, so they cannot catch wheels. -->
    <model name="road_markings">
      <static>true</static>
      <link name="link">
        <visual name="ew_1"><pose>-16 0 0.115 0 0 0</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ew_2"><pose>-10 0 0.115 0 0 0</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ew_3"><pose>10 0 0.115 0 0 0</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ew_4"><pose>16 0 0.115 0 0 0</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ns_1"><pose>0 -16 0.12 0 0 1.5708</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ns_2"><pose>0 -10 0.12 0 0 1.5708</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ns_3"><pose>0 10 0.12 0 0 1.5708</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
        <visual name="ns_4"><pose>0 16 0.12 0 0 1.5708</pose><geometry><box><size>3 0.10 0.01</size></box></geometry><material><diffuse>1 0.8 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Raised pavement blocks define four city blocks. -->
    <model name="sidewalks">
      <static>true</static>
      <link name="link">
        <collision name="nw_collision"><pose>-13 13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry></collision>
        <visual name="nw_visual"><pose>-13 13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry><material><diffuse>0.58 0.58 0.56 1</diffuse></material></visual>
        <collision name="ne_collision"><pose>13 13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry></collision>
        <visual name="ne_visual"><pose>13 13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry><material><diffuse>0.58 0.58 0.56 1</diffuse></material></visual>
        <collision name="sw_collision"><pose>-13 -13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry></collision>
        <visual name="sw_visual"><pose>-13 -13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry><material><diffuse>0.58 0.58 0.56 1</diffuse></material></visual>
        <collision name="se_collision"><pose>13 -13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry></collision>
        <visual name="se_visual"><pose>13 -13 0.09 0 0 0</pose><geometry><box><size>14 14 0.18</size></box></geometry><material><diffuse>0.58 0.58 0.56 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Buildings use simple collision geometry for dependable LiDAR mapping. -->
    <model name="building_nw"><static>true</static><pose>-13 13 3.1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>9 9 6</size></box></geometry></collision><visual name="visual"><geometry><box><size>9 9 6</size></box></geometry><material><diffuse>0.86 0.72 0.50 1</diffuse></material></visual></link></model>
    <model name="building_ne"><static>true</static><pose>13 13 2.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8 10 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 10 5</size></box></geometry><material><diffuse>0.62 0.44 0.38 1</diffuse></material></visual></link></model>
    <model name="building_sw"><static>true</static><pose>-13 -13 2.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 8 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 8 4.5</size></box></geometry><material><diffuse>0.42 0.65 0.78 1</diffuse></material></visual></link></model>
    <model name="building_se"><static>true</static><pose>13 -13 3.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>9 9 7</size></box></geometry></collision><visual name="visual"><geometry><box><size>9 9 7</size></box></geometry><material><diffuse>0.78 0.42 0.40 1</diffuse></material></visual></link></model>

    <!-- Street lamps and parked vehicles provide useful local obstacles. -->
    <model name="street_furniture">
      <static>true</static>
      <link name="link">
        <collision name="lamp_1_collision"><pose>6 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry></collision>
        <visual name="lamp_1_visual"><pose>6 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="lamp_2_collision"><pose>-6 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry></collision>
        <visual name="lamp_2_visual"><pose>-6 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="lamp_3_collision"><pose>5 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry></collision>
        <visual name="lamp_3_visual"><pose>5 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="lamp_4_collision"><pose>-5 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry></collision>
        <visual name="lamp_4_visual"><pose>-5 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <collision name="car_1_collision"><pose>-11 2.4 0.65 0 0 0</pose><geometry><box><size>3.6 1.6 1.2</size></box></geometry></collision>
        <visual name="car_1_visual"><pose>-11 2.4 0.65 0 0 0</pose><geometry><box><size>3.6 1.6 1.2</size></box></geometry><material><diffuse>0.15 0.25 0.75 1</diffuse></material></visual>
        <collision name="car_2_collision"><pose>2.4 -12 0.65 0 0 1.5708</pose><geometry><box><size>3.6 1.6 1.2</size></box></geometry></collision>
        <visual name="car_2_visual"><pose>2.4 -12 0.65 0 0 1.5708</pose><geometry><box><size>3.6 1.6 1.2</size></box></geometry><material><diffuse>0.72 0.18 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Low perimeter barriers keep autonomous exploration inside the map. -->
    <model name="city_boundary">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>0 23 0.5 0 0 0</pose><geometry><box><size>46 0.25 1</size></box></geometry></collision>
        <visual name="north_v"><pose>0 23 0.5 0 0 0</pose><geometry><box><size>46 0.25 1</size></box></geometry><material><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <collision name="south"><pose>0 -23 0.5 0 0 0</pose><geometry><box><size>46 0.25 1</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -23 0.5 0 0 0</pose><geometry><box><size>46 0.25 1</size></box></geometry><material><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <collision name="east"><pose>23 0 0.5 0 0 0</pose><geometry><box><size>0.25 46 1</size></box></geometry></collision>
        <visual name="east_v"><pose>23 0 0.5 0 0 0</pose><geometry><box><size>0.25 46 1</size></box></geometry><material><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <collision name="west"><pose>-23 0 0.5 0 0 0</pose><geometry><box><size>0.25 46 1</size></box></geometry></collision>
        <visual name="west_v"><pose>-23 0 0.5 0 0 0</pose><geometry><box><size>0.25 46 1</size></box></geometry><material><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
